{
  "name": "Daily-Challenge Reminder",
  "description": "Reminds user to complete the LeetCode Daily Challenge Question",
  "version": "0.2.1",
  "manifest_version": 3,
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "Recap.png",
    "48": "Recap.png",
    "128": "Recap.png"
  },
  "permissions": [
    "cookies","alarms","notifications","storage"
  ],
  "host_permissions": [ "https://leetcode.com/*","https://codeforces.com/*"],
  "action": {
    "default_popup": "popup.html"
  }
}